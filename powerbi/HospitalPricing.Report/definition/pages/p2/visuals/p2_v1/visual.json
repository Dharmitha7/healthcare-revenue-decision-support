{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "p2_v1",
  "position": {
    "x": 20,
    "y": 60,
    "z": 20,
    "height": 620,
    "width": 760,
    "tabOrder": 20
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_provider"
                    }
                  },
                  "Property": "provider_name"
                }
              },
              "queryRef": "dim_provider.provider_name",
              "nativeQueryRef": "provider_name",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_provider"
                    }
                  },
                  "Property": "segment"
                }
              },
              "queryRef": "dim_provider.segment",
              "nativeQueryRef": "segment"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Charge Index"
                }
              },
              "queryRef": "_Measures.Charge Index",
              "nativeQueryRef": "Charge Index",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Payment Index"
                }
              },
              "queryRef": "_Measures.Payment Index",
              "nativeQueryRef": "Payment Index"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Each dot is a hospital: charge index (x) vs payment index (y)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}