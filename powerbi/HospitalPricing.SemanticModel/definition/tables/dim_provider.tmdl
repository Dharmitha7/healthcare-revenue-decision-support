		lineageTag: c65fb86b-459a-52a7-a900-1d2be5ddcac5
		summarizeBy: none
		sourceColumn: city

	column street
		dataType: string
		lineageTag: 83f48dcf-5363-5f11-a38c-789816619269
		summarizeBy: none
		sourceColumn: street

	column zip5
		dataType: string
		lineageTag: b405ee4e-b889-557f-ae1e-d572e8333145
		summarizeBy: none
		sourceColumn: zip5

	column state_code
		dataType: string
		lineageTag: d0f2eab7-e161-5c2b-9910-9fd0fab6f1f7
		summarizeBy: none
		sourceColumn: state_code

	column ruca_code
		dataType: double
		lineageTag: ee0cebfe-538a-51a0-ba51-265ba6c4de06
