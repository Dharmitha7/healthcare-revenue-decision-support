	column drg_label
		dataType: string
		lineageTag: 3cfb34d7-83fc-58ea-9cde-65cc5e468528
		summarizeBy: none
		sourceColumn: drg_label
		sortByColumn: drg_code

	partition dim_drg = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_drg.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"drg_code", type text}, {"severity_tier", Int64.Type}, {"hospitals", Int64.Type}, {"nat_charge_per_discharge", type number}, {"nat_payment_per_discharge", type number}, {"nat_pcr", type number}}, "en-US"),
				    Label = Table.AddColumn(Typed, "drg_label", each [drg_code] & " - " & Text.Proper([drg_description]), type text)
				in
				    Label

